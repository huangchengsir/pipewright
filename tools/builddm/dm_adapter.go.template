func init(){
 for _,slot:=range dmTransportSlots.slots{
  dm.RegisterDialContext("pipewright-context-"+strconv.Itoa(slot.id),func(_ context.Context,addr string)(net.Conn,error){return slot.dial(addr)})
 }
 dmConnectorFactory=func(dsn string)(driver.Connector,error){
  u,err:=url.Parse(dsn);if err!=nil||u.Scheme!="dm"{return nil,errors.New("invalid DM URL")}
  q:=u.Query()
  // A driver reconnect must never replay an application write with unknown result.
  for key:=range q{if strings.EqualFold(key,"driverReconnect")||strings.EqualFold(key,"dialName"){q.Del(key)}}
  q.Set("driverReconnect","false");u.RawQuery=q.Encode()
  // Parse once before leasing a slot so invalid URLs do not retain capacity.
  if _,err:=(&dm.DmDriver{}).OpenConnector(u.String());err!=nil{return nil,err}
  return newDMScopedConnector(dmTransportSlots,&dm.DmDriver{},func(id int,probe bool)(driver.Connector,error){
   copyURL:=*u;options:=copyURL.Query();options.Set("dialName","pipewright-context-"+strconv.Itoa(id))
   // The vendor's retry sleep ignores context too; connection attempts are
   // explicit in Pipewright, never an unbounded hidden retry loop.
   if probe {
    for key:=range options{if strings.EqualFold(key,"switchTimes")||strings.EqualFold(key,"switchInterval"){options.Del(key)}}
    options.Set("switchTimes","1");options.Set("switchInterval","0")
   };copyURL.RawQuery=options.Encode()
   return (&dm.DmDriver{}).OpenConnector(copyURL.String())
  }),nil
 }
 dmErrorNumber=func(err error)(int32,bool){var native *dm.DmError;if errors.As(err,&native){return native.ErrCode,true};return 0,false}
 dmDecodeValue=func(ctx context.Context,value driver.Value)(driver.Value,error){
  switch lob:=value.(type){
  case *dm.DmBlob:
   if lob==nil{return nil,nil};if !lob.Valid{return nil,nil}
   length,err:=lob.GetLength();if err!=nil||length<0||length>maxDMLobBytes{return nil,errors.New("store: invalid or oversized DM BLOB")}
   out:=make([]byte,int(length))
   for pos:=0;pos<len(out);{
    if err:=ctx.Err();err!=nil{return nil,err};end:=min(len(out),pos+65536)
    n,err:=lob.ReadAt(pos+1,out[pos:end]);if err!=nil&&!errors.Is(err,io.EOF){return nil,errors.New("store: DM BLOB read failed")};if n<=0||n>end-pos{return nil,errors.New("store: truncated DM BLOB")};pos+=n
   };return out,nil
  case *dm.DmClob:
   if lob==nil{return nil,nil};if !lob.Valid{return nil,nil}
   length,err:=lob.GetLength();if err!=nil||length<0||length>maxDMLobBytes{return nil,errors.New("store: invalid or oversized DM CLOB")}
   var out strings.Builder
   for pos:=int64(0);pos<length;{
    if err:=ctx.Err();err!=nil{return nil,err};take:=min(int64(16384),length-pos)
    part,err:=lob.ReadString(int(pos)+1,int(take));if err!=nil&&!errors.Is(err,io.EOF){return nil,errors.New("store: DM CLOB read failed")}
    count:=utf8.RuneCountInString(part);if !utf8.ValidString(part)||count<=0||int64(count)>take||out.Len()+len(part)>maxDMLobBytes{return nil,errors.New("store: truncated or oversized DM CLOB")}
    out.WriteString(part);pos+=int64(count)
   };return out.String(),nil
  default:return value,nil
  }
 }
 dmDriverSelfTest=func()error{
  ctx:=context.Background()
  for _,b:=range [][]byte{{},{0,255,128,1}}{got,err:=dmDecodeValue(ctx,dm.NewBlob(b));if err!=nil||string(got.([]byte))!=string(b){return errors.New("DM BLOB adapter self-test failed")}}
  for _,s:=range []string{"","中文🙂 α","trailing  "}{got,err:=dmDecodeValue(ctx,dm.NewClob(s));if err!=nil||got!=s{return errors.New("DM CLOB adapter self-test failed")}}
  return nil
 }
}
